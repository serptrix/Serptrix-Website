# Serptrix environment configuration
# Copy to .env.local and fill in verified values.

# Verified business contact email (defaults to hello@serptrix.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# Verified business phone number — leave empty until configured
NEXT_PUBLIC_CONTACT_PHONE=

# Verified Calendly scheduling URL
NEXT_PUBLIC_CALENDLY_URL=

# Optional: webhook URL for contact form submissions (CRM, Zapier, etc.)
CONTACT_WEBHOOK_URL=

# Optional: bearer token sent with webhook requests
CONTACT_WEBHOOK_SECRET=
