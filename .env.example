# Serptrix environment configuration
# Copy to .env.local and fill in verified values.

# Verified business contact email
NEXT_PUBLIC_CONTACT_EMAIL=info@serptrix.com

# Verified business phone number
NEXT_PUBLIC_CONTACT_PHONE=+15402421808

# Verified Calendly scheduling URL
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/serptrix-info/30min?hide_event_type_details=1&hide_gdpr_banner=1

# Required for successful online form delivery (CRM, Zapier, etc.).
# Without it, the API fails safely and directs visitors to email instead.
CONTACT_WEBHOOK_URL=

# Optional: bearer token sent with webhook requests
CONTACT_WEBHOOK_SECRET=

# Optional distributed rate limiting via a Redis-compatible REST endpoint.
# When omitted, a bounded per-instance fallback remains active.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
